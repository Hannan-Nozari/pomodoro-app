<?xml version="1.0" encoding="utf-8"?>
<!-- The notification small icon is resolved by name at runtime (via the
     Capacitor LocalNotifications smallIcon config), so resource shrinking
     cannot see the reference and would strip it, leaving Android to fall back
     to a generic alert glyph. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_pomodoro,@raw/session_alert" />
